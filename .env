# Copy this file to .env and fill in your credentials

# OpenAI API Key (required for OpenAI embeddings)
OPENAI_API_KEY=add your own api key

# Embedding model choice: "openai" or "huggingface" (default: huggingface)
EMBEDDING_MODEL=huggingface

# HuggingFace model name (used when EMBEDDING_MODEL=huggingface)
HF_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistence directory
CHROMA_DB_PATH=./chroma_db

# Resumes directory
RESUMES_DIR=./resumes

# Job descriptions directory
JD_DIR=./job_descriptions

# Top-K results for retrieval
TOP_K=10
